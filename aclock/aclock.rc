-- aclock.rc - Alien Analog Clock
-- v1.0 2026-05-05 @rew62

conky.config = {
    -- window
    own_window            = true,
    own_window_type       = 'normal',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_hints      = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_title      = 'aclock',

    -- position — adjust to taste
    alignment             = 'top_middle',
    gap_x                 = 360,
    gap_y                 = 250,

    -- canvas (must match cx/cy/radius in settings.lua)
    minimum_width         = 200,
    minimum_height        = 200,
    maximum_width         = 200,

    -- rendering
    double_buffer         = true,
    background            = false,
    update_interval       = 1,

    -- lua
    lua_load              = './aclock.lua',
    lua_draw_hook_post    = 'main',

    -- no default text
    draw_shades           = false,
    draw_outline          = false,
    draw_borders          = false,
    use_xft               = true,
    font                  = 'DejaVu Sans:size=1',
    default_color         = '000000',
}

conky.text = [[]]
