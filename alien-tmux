#!/bin/bash
SESSION="conky"
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Window 1: 4 Panes (Scripts 1-4) ---
# Start session with Window 1 named "Main" running Script 1
tmux new-session -d -s $SESSION -n "Conky-1" -c "$BASE_DIR/calendar" 'conky -c hcal2.rc'

# Split into 4 panes and run scripts 2, 3, and 4
tmux split-window -t $SESSION:0 -h -c "$BASE_DIR/calendar" 'conky -c sys-small2.rc'
tmux split-window -t $SESSION:0 -v -c "$BASE_DIR/arc" 'conky -c arc.rc'
tmux split-window -t $SESSION:0 -v -c "$BASE_DIR/gcal" 'conky -c gcal.rc'
tmux select-layout -t $SESSION:0 tiled
tmux select-pane -t $SESSION:0.0

# --- Window 2: 2 Panes (Scripts 5-6) ---
# Create Window 2 named "Secondary" running Script 5
tmux new-window -t $SESSION:1 -n "Conky-2" -c "$BASE_DIR/clock" 'conky -c clock.rc'
tmux split-window -t $SESSION:1 -h -c "$BASE_DIR/clock" 'conky -c song-info.rc'
tmux split-window -t $SESSION:1 -v -c "$BASE_DIR/weather" 'conky -c forecast.rc'
tmux split-window -t $SESSION:1 -v -c "$BASE_DIR/aclock" 'conky -c aclock.rc'
tmux select-layout -t $SESSION:1 tiled
tmux select-pane -t $SESSION:1.3


tmux new-window -t $SESSION:2 -n "Conky-3" -c "$BASE_DIR/vnstat" 'conky -c vnstat.rc'
tmux split-window -t $SESSION:2 -h -c "$BASE_DIR/rss" 'conky -c rss.rc'
tmux split-window -t $SESSION:2 -v -c "$BASE_DIR/earth" 'conky -c earth.rc'
tmux split-window -t $SESSION:2 -v -c "$BASE_DIR/stocks" 'conky -c ticker.rc'
tmux select-layout -t $SESSION:2 tiled
tmux select-pane -t $SESSION:2.3

tmux new-window -t $SESSION:3 -n "Conky-4" -c "$BASE_DIR/terminator" 'conky -c terminator.rc'
tmux split-window -t $SESSION:3 -h -c ""
tmux split-window -t $SESSION:3 -v -c ""
tmux split-window -t $SESSION:3 -v -c ""
tmux select-layout -t $SESSION:3 tiled
tmux select-pane -t $SESSION:3.0

# Attach to the session
tmux attach-session -t $SESSION

