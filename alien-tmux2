#!/usr/bin/env bash

SESSION="conky-by-code"
PANES_PER_WINDOW=4

# --- Resolve base directory of this script ---
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Code → "dir|rcfile" map (single source of truth) ---
declare -A MAP

MAP[a]="arc|arc.rc"
MAP[hc]="calendar|hcal.rc"
MAP[h2]="calendar|hcal2.rc"
MAP[lc]="calendar|lcalendar.rc"
MAP[mc]="calendar|multimon.rc"
MAP[kc]="calendar|kcalendar.rc"
MAP[sc]="calendar|sidepanel-calendar.rc"
MAP[s]="calendar|sys-small.rc"
MAP[s2]="calendar|sys-small2.rc"
MAP[t]="clock|clock.rc"
MAP[m]="music|song-info.rc"
MAP[mp]="music|playerctl.rc"
MAP[e]="earth|earth.rc"
MAP[g]="gcal|gcal.rc"
MAP[r]="rss|rss2.rc"
MAP[$]="stocks|ticker.rc"
MAP[v]="vnstat|vnstat.rc"
MAP[vs]="vnstat|vnstat-summary.rc"
MAP[n]="vnstat|net.rc"
MAP[wc]="weather|owm_current_top.rc"
MAP[wcs]="weather|owm_current_sidepanel.rc"
MAP[wf]="weather|nws_forecast_small.rc"
MAP[wfs]="weather|nws_forecast_sidepanel.rc"
MAP[wa]="weather|full.rc"
MAP[ac]="aclock|aclock.rc"
MAP[tm]="terminator|terminator.rc"
MAP[sd]="solardial|solardial.rc"
MAP[eas]="~/.conky/rew62/system|system.rc"
MAP[ean]="~/.conky/rew62/network|network.rc"
MAP[eaq]="~/.conky/rew62/music/eq/|eq.rc"
MAP[eam]="~/.conky/rew62/moon|moon.rc"

# --- Named groups ---
declare -A NAMED_GROUPS

NAMED_GROUPS[stack1]="h2 a sc mc sd wfs mp n vs"
NAMED_GROUPS[stack2]="h2 lc wf"

# --- Input check ---
if [ "$#" -eq 0 ]; then
    echo "Usage: $(basename "$0") [codes...]"
    echo ""
    echo "  Codes:"
    echo "    ac          aclock"
    echo "    a           arc"
    echo "    t           clock"
    echo "    m           song info"
    echo "    mp          now playing sidepanel"
    echo "    e           earth"
    echo "    g           gcal"
    echo "    r           rss"
    echo "    \$           stocks"
    echo "    v           vnstat"
    echo "    vs          vnstat    (summary)"
    echo "    n           vnstat    (net traffic)"
    echo "    hc          calendar  (hcal)"
    echo "    h2          calendar  (hcal2)"
    echo "    lc          calendar  (lcalendar)"
    echo "    mc          calendar  (multi-month)"
    echo "    kc          calendar  (kcalendar)"
    echo "    sc          calendar  (sidepanel)"
    echo "    s           sys-small"
    echo "    s2          sys-small2"
    echo "    wc          weather   (current top)"
    echo "    wcs         weather   (current sidepanel)"
    echo "    wf          weather   (forecast small)"
    echo "    wfs         weather   (forecast sidepanel)"
    echo "    wa          weather   (full)"
    echo "    tm          day/night terminator map"
    echo "    sd          solar dial"
    echo "    all         launch everything"
    echo ""
    echo "  Groups:"
    for g in "${!NAMED_GROUPS[@]}"; do
        printf "    %-12s %s\n" "$g" "${NAMED_GROUPS[$g]}"
    done
    echo ""
    echo "  Example: $(basename "$0") t wc wf a"
    exit 1
fi

# --- Quit ---
if [[ "$1" == "quit" ]]; then
    tmux kill-session -t "$SESSION" && echo "Killed session: $SESSION" || echo "No session named $SESSION"
    exit
fi

# --- Expand "all" to every defined code ---
expanded=()
for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
        for k in "${!MAP[@]}"; do
            expanded+=("$k")
        done
    elif [[ -n "${NAMED_GROUPS[$arg]}" ]]; then
        read -ra gcodes <<< "${NAMED_GROUPS[$arg]}"
        expanded+=("${gcodes[@]}")
    else
        expanded+=("$arg")
    fi
done
set -- "${expanded[@]}"

# --- Optional bracket parsing ---
if [[ "$1" =~ ^\[.*\]$ ]]; then
    args=$(echo "$1" | tr -d '[]' | tr ',' ' ')
    set -- $args
fi

# --- Remove duplicates ---
declare -A SEEN
FILTERED=()

for code in "$@"; do
    if [[ -z "${SEEN[$code]}" ]]; then
        SEEN[$code]=1
        FILTERED+=("$code")
    fi
done

# --- Initialize window/pane counters, joining existing session if present ---
if tmux has-session -t "$SESSION" 2>/dev/null; then
    win=$(( $(tmux list-windows -t "$SESSION" | wc -l) - 1 ))
    last_panes=$(tmux list-panes -t "$SESSION:$win" | wc -l)
    pane=$(( win * PANES_PER_WINDOW + last_panes ))
else
    win=0
    pane=0
fi

for code in "${FILTERED[@]}"; do

    entry="${MAP[$code]}"

    # --- Ignore invalid codes ---
    if [ -z "$entry" ]; then
        echo "Skipping unknown code: $code"
        continue
    fi

    dir="${entry%%|*}"
    rc="${entry##*|}"

    if [[ "$dir" = ~* ]]; then
        full_dir="${dir/#\~/$HOME}"
    elif [[ "$dir" = /* ]]; then
        full_dir="$dir"
    else
        full_dir="$BASE_DIR/$dir"
    fi
    full_rc="$full_dir/$rc"

    # --- Validation checks ---
    if [ ! -d "$full_dir" ]; then
        echo "Skipping $code → directory not found: $full_dir"
        continue
    fi

    if [ ! -f "$full_rc" ]; then
        echo "Skipping $code → rc file not found: $full_rc"
        continue
    fi

    # --- Skip if already running ---
    if pgrep -f "conky -c $rc" > /dev/null 2>&1; then
        echo "Skipping $code → already running (conky -c $rc)"
        continue
    fi

    cmd="conky -c $rc"

    # --- New window every N panes ---
    if (( pane % PANES_PER_WINDOW == 0 )); then
        if (( pane == 0 )); then
            tmux new-session -d -s "$SESSION" -n "Conky-1" -c "$full_dir"
        else
            ((win++))
            tmux new-window -t "$SESSION:$win" -n "Conky-$((win+1))" -c "$full_dir"
        fi
        tmux send-keys -t "$SESSION:$win.0" "$cmd" C-m
    else
        tmux split-window -t "$SESSION:$win" -c "$full_dir"
        tmux select-layout -t "$SESSION:$win" tiled
        tmux send-keys -t "$SESSION:$win" "$cmd" C-m
    fi

    ((pane++))
done

# --- Bail if nothing valid was launched ---
if (( pane == 0 )); then
    echo "No valid codes provided. Nothing started."
    exit 1
fi

# --- Final layout cleanup ---
for ((i=0; i<=win; i++)); do
    tmux select-layout -t "$SESSION:$i" tiled
done

tmux attach-session -t "$SESSION"
