-- playerctl.rc - Music Now Playing Sidepanel (playerctl)
-- v1.0 2026-05-19 @rew62

conky.config = {

-- Size and Position --
  alignment = 'top_right',
  gap_x = 260,
  gap_y = 563,
  maximum_width = 320,
  minimum_width = 314,
  minimum_height = 60,

-- Text --
  use_xft = true,
  override_utf8_locale = true,
  font = 'Roboto:size=2',

-- Colors --
  default_color = 'ffffff',
  default_outline_color = 'white',
  default_shade_color = 'white',
  color1 = '7342EB',
  color2 = '2D9EEA',
  color3 = '9EAD6E', -- lighter, more sage-like
  --color3 = '8A9A5B', --classic muted olive green
  --color3 = 'C8A84B', --warm golden yellow, muted
  --color3 = 'D4B85A', --slightly brighter but still muted

-- Window --
  background = false,
  border_width = 1,
  draw_borders = false,
  draw_blended = false,
  draw_graph_borders = false,
  draw_outline = false,
  draw_shades = false,
  own_window = true,
  own_window_colour = '000000',
  own_window_class = 'Conky',
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  own_window_type = 'normal',
  own_window_transparent = true,
  own_window_hints  = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_title  = 'sp-playerctl',
  stippled_borders = 0,

-- Other --
  cpu_avg_samples = 2,
  net_avg_samples = 2,
  double_buffer = true,
  out_to_console = false,
  out_to_stderr = false,
  extra_newline = false,
  update_interval = 1,
  uppercase = false,
  short_units = true,
  use_spacer = 'none',
  show_graph_scale = false,
  show_graph_range = false,
  format_human_readable = true,

-- Lua Load
  lua_load = './settings.lua ./loadall.lua',
  lua_startup_hook = 'vars',
  lua_draw_hook_pre = 'main',
}

conky.text = [[
${voffset 20}${goto 20}${color3}${font MonaspiceNe Nerd Font Mono:size=36}󰎇${font}${color}
${voffset -45}${color2}${offset 60}${font Rubik:bold:size=12}${execi 5 ./music_info.sh artist}
${offset 60}${color}${font Rubik:size=10}${execi 5 ./music_info.sh title}${font}
${offset 60}${voffset 10}${color2}${font Rubik:size=10}${exec ./music_info.sh status}${offset 100}${exec ./music_info.sh time}${font}${voffset -25}]]
