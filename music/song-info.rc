-- song-info.rc - Single Line Song Information that sites below Arc
-- v1.1 2026-05-20 @rew62

conky.config = {
-- Window / positioning
   alignment          = 'top_middle',

   minimum_width      = 800,
   maximum_width      = 800,
   minimum_height     = 20,

   gap_x              = 0,
   gap_y              = 375,

-- Transparent background
   own_window         = true,
   own_window_type    = 'normal',
   own_window_title   = 'song-info',
   own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
   draw_shades        = false,
   draw_outline       = false,
   draw_borders       = false,
   own_window_transparent = true,
   own_window_argb_visual = true,
   own_window_argb_value  = 0,          -- 0 = fully transparent
   own_window_colour  = '#000000',

-- No borders / decorations
   draw_borders       = false,
   draw_graph_borders = false,
   border_width       = 0,

-- Rendering
   double_buffer      = true,
   --no_buffers       = true,
   update_interval    = 1,
   short_units        = true,
   cpu_avg_samples    = 2,
   use_xft            = true,

-- Fonts
   font               = 'DejaVuSansM Nerd Font Propo:style=Medium:size=10',
   --font2              = 'Inter Tight:size=12',
   font2              = 'Rubik:bold:size=10',
   override_utf8_locale = true,

-- Colors
   default_color      = 'white',
   color1             = 'f5d080',       -- values / totals (bright)
   color2             = '60c888',       -- RX (green)
   color3             = 'e07050',       -- TX (red-orange)
   color4             = '8a6030',       -- dimmed / comments
   color5             = 'a06828',       -- tree lines
   color6             = 'f0c070',       -- section headers

-- Lua Load 
   lua_load = './settings.lua',
   lua_startup_hook = 'vars',
}

conky.text = [[
${voffset 90}${alignc}${font2}${if_match "${execi 1 ./music_info.sh status}" != ""}Now Playing: ${color #1ed760}${execi 5 ./music_info.sh display}${color6}   [ ${execi 1 ./music_info.sh time} ]${endif}
]]
