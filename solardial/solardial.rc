-- solardial.rc - Solar Dial with Corner Complications modeled after Apple Solar Dial
-- v1 2026-05-14 @rew62

conky.config = {

    background = false,
    use_xft = true,
    double_buffer = true,
    update_interval = 0.5,

    own_window = true,
    own_window_type = 'normal',
    own_window_hints = 'undecorated',

    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,

    minimum_width = 315,
    minimum_height = 315,

    maximum_width = 315,

    gap_x = 260,
    gap_y = 50,

    alignment = 'top_right',

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,

    use_spacer = 'none',

    --lua_load = './dial2.lua',
    --lua_draw_hook_pre = 'solar_dial',

    -- Lua Load
    lua_load = './settings.lua ./loadall.lua',
    lua_startup_hook = 'vars',
    lua_draw_hook_pre = 'main',
}

conky.text = [[
]]
