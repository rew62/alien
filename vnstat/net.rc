-- net.rc - network stats panel
-- v1.0 2026-05-19 @rew62

conky.config = {

-- Size and Position --
  alignment = 'top_right',
  gap_x = 260,
  gap_y = 668,
  minimum_height = 140,
  minimum_width = 315,
  maximum_width = 315,

-- Text --
  use_xft = true,
  override_utf8_locale = true,
  font = 'Roboto:size=2',

-- Colors --
  default_color = 'ffffff',
  default_outline_color = 'white',
  default_shade_color = 'white',
  color1 = '7342EB',
  color2 = '2D9EEA',

-- Window --
  background = false,
  border_width = 1,
  draw_borders = false,
  draw_blended = false,
  draw_graph_borders = false,
  draw_outline = false,
  draw_shades = false,
  own_window = true,
  own_window_colour = '000000',
  own_window_class = 'Conky',
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  own_window_type = 'normal',
  own_window_transparent = true,
  own_window_hints  = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_title  = 'sp-net',
  stippled_borders = 0,

-- Other --
  cpu_avg_samples = 2,
  net_avg_samples = 2,
  double_buffer = true,
  out_to_console = false,
  out_to_stderr = false,
  extra_newline = false,
  update_interval = 1,
  uppercase = false,
  short_units = true,
  use_spacer = 'none',
  show_graph_scale = false,
  show_graph_range = false,
  format_human_readable = true,

-- Lua Load
  lua_load = './settings.lua ./loadall.lua',
  lua_startup_hook = 'vars',
  lua_draw_hook_pre = 'main',
   
-- Templates
  template1 = "wlp2s0",					-- LAN interface name
}

conky.text = [[
${offset 10}${voffset 25}${color2}${font Rubik:size=8}DOWN : ${goto 50}${color}${downspeed ${template1}}${goto 80}  |    ${totaldown ${template1}}
${offset 10}${voffset 0}${color2}${downspeedgraph ${template1} 28,115}
${offset 10}${voffset 5}${color2}${font Rubik:size=8}UP : ${goto 50}${color}${upspeed ${template1}}${goto 80}  |    ${totalup ${template1}}
${offset 10}${voffset 0}${color2}${upspeedgraph ${template1} 28,115}
${offset 155}${voffset -120}${font Material:size=14}${voffset -3}${font Rubik:bold:size=8}${color}   ${wireless_essid ${template1}}
${offset 155}${voffset 8}${color2}${font Rubik:bold:size=8}LOCAL IP
${offset 155}${voffset 0}${color}${font Rubik:bold:size=9}${addr ${gw_iface}}
${offset 155}${voffset 8}${color2}${font Rubik:bold:size=8}PUBLIC IP
${offset 155}${voffset 0}${color}${font Rubik:bold:size=9}${texeci 86400 curl -s https://api.ipify.org} 
${offset 155}${voffset 8}${color2}${font Rubik:bold:size=8}IN: ${color}${font Rubik:size=8}${tcp_portmon 1 32767 count}${color2}${font Rubik:bold:size=8}       OUT: ${color}${font Rubik:size=8}${tcp_portmon 32768 61000 count}${alignr}${color2}${font Rubik:bold:size=8}TOTAL: ${color2}${font Rubik:size=8}${color}${tcp_portmon 1 65535 count}${voffset -115}]]
