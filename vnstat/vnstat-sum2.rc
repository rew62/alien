-- vnstat-sum2.rc - vnstat day/week/month summary (Cairo renderer)
-- v1.0 2026-06-16 @rew62

conky.config = {
    -- Window / positioning
    alignment          = 'top_right',
    gap_x              = 264,
    gap_y              = 826,
    minimum_width      = 307,
    maximum_width      = 307,
    minimum_height     = 155,

    -- Transparent background
    own_window         = true,
    own_window_type    = 'normal',
    own_window_title   = 'vnstat-sum2',
    own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_colour  = '#000000',

    -- No borders / decorations
    draw_borders       = false,
    draw_graph_borders = false,
    border_width       = 0,
    border_inner_margin = 0,

    -- Rendering
    double_buffer      = true,
    no_buffers         = true,
    update_interval    = 60,
    cpu_avg_samples    = 2,
    use_xft            = true,
    override_utf8_locale = true,

    -- Lua script
    lua_load           = './settings.lua ./loadall.lua',
    lua_draw_hook_post = 'main',
    lua_startup_hook   = 'vars',
}

conky.text = [[
]]
