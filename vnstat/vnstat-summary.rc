-- vnstat-summary.rc - vnstat day/week/month summary conky widget
-- v1.0 2026-05-10 @rew62

conky.config = {
    -- Window / positioning
    alignment          = 'top_right',
    gap_x              = 264,
    gap_y              = 826,
    minimum_width      = 307,
    maximum_width      = 307,

    -- Transparent background
    own_window         = true,
    own_window_type    = 'normal',
    own_window_title   = 'vnstat-summary',
    own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value  = 0,          -- 0 = fully transparent
    own_window_colour  = '#000000',

    -- No borders / decorations
    draw_borders       = false,
    draw_graph_borders = false,
    border_width       = 0,
    border_inner_margin = 8,

    -- Rendering
    double_buffer      = true,
    no_buffers         = true,
    update_interval    = 60,             -- refresh every 60 s
    cpu_avg_samples    = 2,
    use_xft            = true,

    -- Font (monospace is essential for alignment)
    --font               = 'Monospace:size=9',
    --font              = 'Inter Tight:size=14',
    --font              = 'DejaVuSansM Nerd Font Propo:size=12',
    --font              = 'IBM Plex Mono:fontfeatures=tnum:size=12',
    font              = 'DejaVuSansM Nerd Font Propo:size=12',
    override_utf8_locale = true,

    -- Colors (match vnstat.rc theme)
    default_color      = 'e8a84a',
    color1             = 'f5d080',       -- values / totals (bright)
    color2             = '60c888',       -- RX (green)
    color3             = 'f05555',       -- TX (red)
    color4             = '8a6030',       -- dimmed / comments
    color5             = 'a06828',       -- tree lines
    color6             = '89b4fa',       -- section headers (theme border blue)

    -- Lua script
    lua_load           = './settings.lua ./loadall.lua',
    lua_draw_hook_post = 'main',
    lua_startup_hook   = 'vars',
}

conky.text = [[
${voffset 5}${lua_parse draw_vnstat_summary}
]]
