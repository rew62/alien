-- nws_forecast_sidepanel.rc - 5-day NWS forecast sidepanel widget
-- Visual port of wttr/nws_forecast.rc; drawn entirely by Lua/Cairo.
-- v1.0 2026-05-21 @rew62

conky.config = {
    -- Window
    own_window             = true,
    own_window_type        = "normal",
    own_window_title       = "w-forecast-sidepanel",
    own_window_hints       = "undecorated,below,sticky,skip_taskbar,skip_pager",
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    double_buffer          = true,
    no_buffers             = true,

    -- Size and position (matches wttr original)
    minimum_width          = 321,
    maximum_width          = 321,
    minimum_height         = 178,
    border_inner_margin    = 0,
    alignment              = "top_right",
    gap_x                  = 257,
    gap_y                  = 375,

    -- Typography
    use_xft                = true,
    font                   = "DejaVuSansM Nerd Font Propo:size=9",
    xftalpha               = 1,
    default_color          = "ffffff",

    -- Performance
    update_interval        = 60,
    total_run_times        = 0,

    -- Drawing
    draw_shades            = false,
    draw_outline           = false,
    draw_borders           = false,
    draw_graph_borders     = false,
    border_inner_margin    = 0,
    border_outer_margin    = 0,

    -- Lua
    lua_load               = './settings.lua ./loadall.lua',
    lua_startup_hook       = 'weather_update',
    lua_draw_hook_post     = 'main',
}

conky.text = [[

]]
